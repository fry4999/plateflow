APP_BASE_URL=http://localhost:4321
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Create this in the Onshape Developer Portal.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_OAUTH_BASE=https://oauth.onshape.com
ONSHAPE_API_BASE=https://cad.onshape.com

# Optional. Leave blank unless your app registration requires a specific scope string.
ONSHAPE_OAUTH_SCOPE=

# Optional procurement matching. Defaults to FRC Tools Orders public vendor search.
FRC_TOOLS_SEARCH_URL=https://orders.frctools.com/api/vendors/search
FRC_TOOLS_MATCH_TTL_MS=43200000

# Production hardening.
TRUST_PROXY=false
